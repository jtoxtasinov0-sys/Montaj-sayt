# ================== ASOSIY ==================
# Sayt manzili (https bilan, oxirida / siz). Google va Telegram shu manzilni ishlatadi.
APP_URL=https://montajchi.uz
NEXT_PUBLIC_SITE_NAME="Montaj Club"

# PostgreSQL. docker-compose ishlatilsa DATABASE_URL avtomatik yig'iladi — faqat parolni yozing.
POSTGRES_PASSWORD=uzun-va-tasodifiy-parol-kiriting
# Dokploy'ning alohida Postgres xizmati ishlatilsa — uning "Internal connection URL" ini shu yerga:
# DATABASE_URL=postgres://user:pass@montaj-db:5432/montaj

# Adminlar: shu Gmail'lar bilan kirganlar avtomatik ADMIN bo'ladi (vergul bilan)
ADMIN_EMAILS=siz@gmail.com

# ================== GOOGLE LOGIN ==================
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorized redirect URI:  https://montajchi.uz/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ================== TELEGRAM BOT ==================
# @BotFather → /newbot → token. Botga /start yozing — u chat ID va sizning ID ni ko'rsatadi.
TELEGRAM_BOT_TOKEN=
# To'lov xabarlari keladigan chat (shaxsiy chat yoki admin guruh ID si, guruh bo'lsa minus bilan)
TELEGRAM_ADMIN_CHAT_ID=
# Tasdiqlash tugmasini bosishga ruxsat berilgan Telegram user ID lar (vergul bilan)
TELEGRAM_ADMIN_IDS=
# Webhook himoyasi uchun tasodifiy satr (masalan: openssl rand -hex 32)
TELEGRAM_WEBHOOK_SECRET=

# ================== AVTOMATIK TO'LOV ==================
# Kartaga pul tushganda bank SMS'ini telefondagi "SMS forwarder" ilovasi shu manzilga yuboradi:
#   POST https://montajchi.uz/api/payments/incoming   (sarlavha: X-Payment-Secret: <kalit>  yoki  ?key=<kalit>)
# Summa kutilayotgan to'lovga (narx + shaxsiy kod) aynan teng bo'lsa — TOP o'zi yoqiladi.
# Bo'sh qolsa ham ishlaydi: bank xabarini admin Telegram botga forward qiladi. Uzun tasodifiy satr: openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=

# ================== UNUMDORLIK ==================
# Next.js ishchi jarayonlari soni (standart = CPU yadrolari soni). 2 vCPU VPS → 2
WEB_CONCURRENCY=2
# Har bir ishchining DB ulanishlari soni (WEB_CONCURRENCY × DB_POOL_MAX < 90 bo'lsin)
DB_POOL_MAX=10
# Kirmagan mehmonlar uchun sahifa keshi (ms). 0 = o'chirish
MICROCACHE_TTL_MS=10000

# ================== FAQAT LOKAL ISHLAB CHIQISH ==================
# Google kalitlarisiz test kirish (faqat APP_URL=http://localhost bo'lganda ishlaydi)
# ALLOW_DEV_LOGIN=true
